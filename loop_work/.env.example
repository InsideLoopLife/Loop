NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key

# Optional later for nightly server-side snapshots / deployed cron jobs.
# Do NOT expose this in browser code or any NEXT_PUBLIC variable.
SUPABASE_SECRET_KEY=sb_secret_your_secret_key
CRON_SECRET=make-a-long-random-secret

# Required before saving API tokens in Integrations. Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=replace_with_32_byte_base64_key

# Recommended before hosting online. Use "closed" for a private family app or "invite" when we add invite-code flows.
APP_SIGNUP_MODE=closed
NEXT_PUBLIC_APP_SIGNUP_MODE=closed

# V22 account/admin/notification settings
APP_BASE_URL=http://localhost:3000
APP_CREATOR_EMAILS=you@example.com
RESEND_API_KEY=
EMAIL_FROM="Life Tracker <updates@yourdomain.com>"
EMAIL_REPLY_TO=
APP_SIGNUP_MODE=invite
NEXT_PUBLIC_APP_SIGNUP_MODE=invite

# Optional branded/local email sender. For Gmail, use a Google App Password.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=help@yourdomain.com
SMTP_APP_PASSWORD=your_new_google_app_password
SMTP_TLS_REJECT_UNAUTHORIZED=true
# If local Node reports a certificate-chain issue, use false only for local testing and fix CA/cert config before production.
# SMTP_TLS_REJECT_UNAUTHORIZED=false

# V27.1 auth/provider options
# Use either variable name for the server-side Supabase admin/service key.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
NEXT_PUBLIC_ENABLE_APPLE_AUTH=false

# Private beta access gate. Prefer hash + opaque cookie value in production.
# Generate hash with: node -e "const crypto=require('crypto'); console.log(crypto.createHash('sha256').update('YOURCODE:loop').digest('hex'))"
LOOP_ACCESS_REQUIRED=false
LOOP_ACCESS_CODE_HASH=
LOOP_ACCESS_CODE_SALT=loop
LOOP_ACCESS_COOKIE_VALUE=

# V27.23 protected admin page. Defaults to help@gamingnectar.com if not set,
# but set this explicitly before production.
APP_ADMIN_EMAILS=help@gamingnectar.com
# LOOP_ADMIN_EMAILS=help@gamingnectar.com

# SnapTrade - server-side only. Do not prefix these with NEXT_PUBLIC.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_BASE_URL=https://api.snaptrade.com/api/v1
SNAPTRADE_CONNECTION_REDIRECT_URL=http://localhost:3000/integrations/snaptrade/callback
