{
  "name": "life-tracker-web-responsive",
  "version": "0.25.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "worker:investment-prices": "tsx -r tsconfig-paths/register scripts/market-data-direct-worker.ts",
    "dev:webpack": "next dev",
    "worker:market-data": "tsx -r tsconfig-paths/register scripts/market-data-direct-worker.ts",
    "worker:market-data-http": "node scripts/investment-price-worker.mjs",
    "worker:investment-prices-http": "node scripts/investment-price-worker.mjs",
    "worker:pension-provider-refresh": "tsx -r tsconfig-paths/register scripts/pension-provider-refresh-worker.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run build",
    "worker:all": "npm run worker:market-data",
    "watch:savings-rates": "node scripts/run-savings-rate-watch.mjs",
    "worker:savings-rates": "node scripts/savings-rate-watch-worker.mjs",
    "refresh:pension-performance": "node scripts/run-pension-performance-refresh.mjs",
    "cron:run-endpoint": "node scripts/run-loop-cron-endpoint.mjs",
    "cron:financial-briefing": "node scripts/run-daily-financial-briefing.mjs",
    "check:boundaries": "node scripts/check-domain-boundaries.mjs",
    "check:architecture": "npm run check:boundaries",
    "cron:fees": "tsx -r tsconfig-paths/register cron-fees.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.108.1",
    "dotenv": "^16.4.5",
    "lucide-react": "1.17.0",
    "openai": "^4.68.0",
    "playwright": "^1.48.0",
    "next": "16.2.9",
    "node-cron": "^3.0.3",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "3.8.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.22",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "postcss": "8.5.15",
    "tailwindcss": "3.4.17",
    "typescript": "6.0.3"
  },
  "overrides": {
    "postcss": "8.5.15",
    "openai": {
      "zod": "$zod"
    }
  }
}
