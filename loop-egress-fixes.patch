+// The continuous price loop (see scripts/market-data-direct-worker.ts) can
+// tick as often as once a minute. wealth_watch_settings and app_user_profiles
+// barely ever change tick-to-tick, so re-fetching them on every single run
+// was pure wasted egress — this was one of three near-identical requests
+// firing every 60s regardless of whether any holding actually needed a
+// price check. Cache both for a few minutes and only pay for a fresh read
+// periodically, or when a holding references a user we haven't seen before.
+const SETTINGS_CACHE_TTL_MS = Math.max(
+  1,
+  Number(process.env.MARKET_DATA_WORKER_SETTINGS_CACHE_MINUTES) || 10,
+) * 60 * 1000;
+const PROFILE_CACHE_TTL_MS = Math.max(
+  1,
+  Number(process.env.MARKET_DATA_WORKER_PROFILE_CACHE_MINUTES) || 10,
+) * 60 * 1000;
+
+let settingsCache: { value: Awaited<ReturnType<typeof loadInvestmentSnapshotSettings>>; loadedAt: number } | null = null;
+
+async function getCachedSnapshotSettings(supabase: SupabaseAdmin) {
+  const now = Date.now();
+  if (settingsCache && now - settingsCache.loadedAt < SETTINGS_CACHE_TTL_MS) {
+    return settingsCache.value;
+  }
+  const value = await loadInvestmentSnapshotSettings(supabase);
+  settingsCache = { value, loadedAt: now };
+  return value;
+}
+
+const profileCache = new Map<string, { value: UserProfileRow; loadedAt: number }>();
+
+async function getCachedUserProfiles(supabase: SupabaseAdmin, userIds: string[]) {
+  const now = Date.now();
+  const stale = userIds.filter((id) => {
+    const cached = profileCache.get(id);
+    return !cached || now - cached.loadedAt >= PROFILE_CACHE_TTL_MS;
+  });
+
+  if (stale.length) {
+    const { data, error } = await supabase
+      .from("app_user_profiles")
+      .select(
+        "user_id, payment_tier, payment_tier_status, payment_tier_override, market_data_tier, market_data_tier_override, market_data_provider_status, market_data_realtime_enabled",
+      )
+      .in("user_id", stale);
+    if (!error) {
+      for (const profile of (data || []) as UserProfileRow[]) {
+        profileCache.set(profile.user_id, { value: profile, loadedAt: now });
+      }
+      // A user_id with no profile row (deleted account, edge case) would
+      // otherwise be re-queried every single tick forever — cache a null
+      // marker for it too so it stops costing a request each cycle.
+      const found = new Set(((data || []) as UserProfileRow[]).map((p) => p.user_id));
+      for (const id of stale) {
+        if (!found.has(id)) profileCache.set(id, { value: { user_id: id } as UserProfileRow, loadedAt: now });
+      }
+    }
+  }
+
+  return userIds
+    .map((id) => profileCache.get(id)?.value)
+    .filter((v): v is UserProfileRow => Boolean(v));
+}
